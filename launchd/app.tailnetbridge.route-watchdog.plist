<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.tailnetbridge.route-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/tailnet-bridge/tailscale-watchdog.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/tailnet-bridge-route-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tailnet-bridge-route-watchdog.log</string>
</dict>
</plist>
